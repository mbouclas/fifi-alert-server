{% extends "common/layout.nunj" %}

{% block title %}Confirm Account Deletion - FiFi Alert{% endblock %}

{% block header %}Confirm Account Deletion ⚠️{% endblock %}

{% block content %}
  <mj-text font-size="18px" font-weight="bold" color="#333333" padding-bottom="20px">
    Hi {{ user.firstName|default('there') }},
  </mj-text>

  <mj-text padding-bottom="20px">
    We received a request to permanently delete the FiFi Alert account for
    <strong>{{ user.email }}</strong>.
  </mj-text>

  <mj-text padding-bottom="20px">
    Deleting your account removes your pets, alerts, sightings and saved zones. This cannot be undone.
  </mj-text>

  <mj-button background-color="#dc3545" color="#ffffff" href="{{ deleteLink }}" padding="15px 0px">
    Yes, Delete My Account
  </mj-button>

  <mj-text padding-top="20px" font-size="12px" color="#666666">
    If the button doesn't work, copy and paste this URL into your browser:<br/>
    <a href="{{ deleteLink }}" style="color: #dc3545;">{{ deleteLink }}</a>
  </mj-text>

  <mj-divider border-width="1px" border-color="#e0e0e0" padding="30px 0px" />

  <mj-text font-size="13px" color="#666666" padding-bottom="10px">
    <strong>This link will expire in {{ expiresIn|default('24 hours') }}.</strong>
  </mj-text>

  <mj-text font-size="13px" color="#666666">
    If you didn't request this, ignore this email and your account will stay exactly as it is.
    Consider changing your password if you did not make this request.
  </mj-text>
{% endblock %}
