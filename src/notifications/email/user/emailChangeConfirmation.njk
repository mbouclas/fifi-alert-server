{% extends "common/layout.nunj" %}

{% block title %}Confirm Your Email Change - FiFi Alert{% endblock %}

{% block header %}Confirm Your Email Change ✉️{% endblock %}

{% block content %}
  <mj-text font-size="18px" font-weight="bold" color="#333333" padding-bottom="20px">
    Hi {{ user.firstName|default('there') }},
  </mj-text>

  <mj-text padding-bottom="20px">
    We received a request to change the email address on your FiFi Alert account from
    <strong>{{ user.email }}</strong> to <strong>{{ newEmail }}</strong>.
  </mj-text>

  <mj-text padding-bottom="20px">
    If you made this request, confirm it below. We will then send a verification link to
    <strong>{{ newEmail }}</strong> to complete the change.
  </mj-text>

  <mj-button background-color="#007bff" color="#ffffff" href="{{ confirmLink }}" padding="15px 0px">
    Confirm Email Change
  </mj-button>

  <mj-text padding-top="20px" font-size="12px" color="#666666">
    If the button doesn't work, copy and paste this URL into your browser:<br/>
    <a href="{{ confirmLink }}" style="color: #007bff;">{{ confirmLink }}</a>
  </mj-text>

  <mj-divider border-width="1px" border-color="#e0e0e0" padding="30px 0px" />

  <mj-text font-size="13px" color="#666666" padding-bottom="10px">
    <strong>This link will expire in {{ expiresIn|default('24 hours') }}.</strong>
  </mj-text>

  <mj-text font-size="13px" color="#666666">
    If you didn't request this change, you can safely ignore this email. Your email address
    will not be changed. We recommend changing your password if you did not make this request.
  </mj-text>
{% endblock %}
