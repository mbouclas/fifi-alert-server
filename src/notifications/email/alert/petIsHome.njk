{% extends "common/layout.nunj" %}

{% block title %}{{ reunion.petName }} is home! - FiFi Alert{% endblock %}

{% block header %}🎉 {{ reunion.petName }} is home!{% endblock %}

{% block content %}
  <mj-text font-size="18px" font-weight="bold" color="#333333" padding-bottom="20px">
    Hi {{ user.firstName|default('there') }},
  </mj-text>

  <mj-text padding-bottom="20px">
    Good news: <strong>{{ reunion.petName }}</strong> has been found and is back with their family.
    You were one of the neighbours who kept an eye out, and that made a difference. Thank you.
  </mj-text>

  {% if reunion.photoUrl %}
  <mj-image src="{{ reunion.photoUrl }}" alt="{{ reunion.petName }}" padding-bottom="20px" border-radius="8px" />
  {% endif %}

  {% if reunion.thankYouMessage %}
  <mj-divider border-width="2px" border-color="#28a745" padding="20px 0px" />

  <mj-text font-size="16px" font-weight="bold" color="#28a745" padding-bottom="10px">
    A note from {{ reunion.petName }}'s family:
  </mj-text>

  <mj-text font-style="italic" padding-bottom="20px">
    “{{ reunion.thankYouMessage }}”
  </mj-text>
  {% endif %}

  <mj-divider border-width="1px" border-color="#e0e0e0" padding="20px 0px" />

  <mj-button background-color="#28a745" color="#ffffff" href="{{ reunion.viewUrl }}" padding="15px 0px">
    See the reunion
  </mj-button>

  <mj-text padding-top="30px" font-size="12px" color="#999999">
    You're receiving this because you were notified about {{ reunion.petName }} going missing or reported a sighting.
    To adjust your alert settings, visit your account preferences.
  </mj-text>
{% endblock %}
