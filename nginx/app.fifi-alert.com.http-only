# Bootstrap vhost for app.fifi-alert.com — HTTP only, used before the certificate exists.
# Install this as /etc/nginx/sites-available/app.fifi-alert.com, reload, then run
#   sudo certbot --nginx -d app.fifi-alert.com
# certbot will rewrite it with the SSL block (or replace it with nginx/app.fifi-alert.com afterwards).

server {
    listen 80;
    listen [::]:80;
    server_name app.fifi-alert.com;

    client_max_body_size 25M;

    location / {
        proxy_connect_timeout       600;
        proxy_send_timeout          600;
        proxy_read_timeout          600;
        send_timeout                600;

        proxy_pass http://127.0.0.1:3113;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
